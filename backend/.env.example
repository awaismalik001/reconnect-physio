# ═══════════════════════════════════════════════════════════
#  Reconnect-Physiotherapy Center — Backend environment
#  Copy this file to ".env" and fill in YOUR real values:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
#  NOTE: Never put real secrets in this file — it is committed
#  to version control. Real values belong in ".env" only.
# ═══════════════════════════════════════════════════════════

# ── JWT Authentication ─────────────────────────────────────
# Secret used to sign/verify admin login tokens.
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
# Token lifetime (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# ── MongoDB (local installation) ───────────────────────────
# URI for a locally installed MongoDB. mongod must be running
# (default port 27017). Replace <your_db_name> with your DB name.
# If you move to MongoDB Atlas later, use your Atlas URI instead:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<your_db_name>
MONGODB_URI=mongodb://127.0.0.1:27017/your_db_name

# ── Server ─────────────────────────────────────────────────
# Port the Express API listens on
PORT=5000

# ── File uploads ───────────────────────────────────────────
# Folder for uploaded files, relative to the backend root
UPLOAD_PATH=uploads

# ── Frontend / CORS ────────────────────────────────────────
# URL of the frontend app allowed to call this API
# (localhost:5173 = default Vite dev server)
CLIENT_URL=http://localhost:5173
